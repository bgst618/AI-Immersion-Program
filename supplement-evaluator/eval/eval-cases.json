{
  "_readme": "Golden eval set for the supplement evaluator. Runs against the REAL model (not mocks). Input field names are generic — map them to schema.ts. Bloodwork marker names assume the dropdown includes vitamin D and ferritin; swap in your actual fixed markers if different.",

  "scoring": {
    "runs_per_case": 5,
    "pass_rules": {
      "verdict": "Output verdict must be in acceptable_verdicts on every run.",
      "confidence": "Output confidence must be in acceptable_confidence on every run.",
      "reason_must_mention": "Reason must reference at least one of these terms (case-insensitive) — checks the verdict is tied to the stated goal.",
      "reason_must_not_mention": "Global banned list applies to every case (see below), plus any per-case additions. A hit is a FAIL, not a log.",
      "consistency": "Verdict identical across all runs; confidence identical in >= 4 of 5 runs. Cases marked ambiguous: true are scored on consistency only — the exact answer is debatable, but flip-flopping is not acceptable.",
      "pairs": "Cases sharing a pair_id must produce DIFFERENT verdicts from each other. If they match, that input (goal or bloodwork) is not actually driving the decision.",
      "suggestions": "When expect_suggestions is present, on every run: suggestion count within min_count/max_count, every confidence in acceptable_confidence, every suggestion in the allowed list (relevance to the stated goal), none in must_not_include (things the user already takes), goalsAddressed non-empty and within the case's goals, and no banned phrases."
    },
    "global_reason_must_not_mention": [
      "your diet", "you eat", "if you eat", "dietary intake", "from food", "food sources",
      "brand", "Optimum Nutrition", "Thorne", "NOW Foods", "Garden of Life", "per serving"
    ],
    "confidence_values": ["Strong", "Moderate", "Weak", "Insufficient"]
  },

  "cases": [
