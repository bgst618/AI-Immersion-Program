{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "supplement-evaluator",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-20",
  "workers_dev": true,
  "vars": {
    // Swap models without a code change. NVIDIA_API_KEY is a secret
    // (wrangler secret put NVIDIA_API_KEY), so it isn't set here.
    "MODEL": "nvidia/nemotron-3-super-120b-a12b"
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
